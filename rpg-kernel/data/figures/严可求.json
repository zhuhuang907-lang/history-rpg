    "timeline": [
      {
        "y": 903,
        "m": null,
        "kind": "event",
        "text": "向徐温提出诱捕朱延寿的计划，徐温告诉杨行密，杨行密采纳；朱延寿死后，杨行密提拔了徐温和严可求",
        "seat": "广陵"
      },
      {
        "y": 905,
        "m": 9,
        "kind": "event",
        "text": "杨行密病笃，独留严可求；严可求和徐温去见周隐，取牒文送给杨渥，杨渥回到广陵",
        "seat": "广陵"
      },
      {
        "y": 908,
        "m": null,
        "kind": "event",
        "text": "张颢、徐温刺杀杨渥；严可求以史太夫人名义写教令，拥立杨隆演；劝徐温留广陵；张颢派刺客杀严可求，刺客被打动留下其性命",
        "seat": "广陵"
      },
      {
        "y": 908,
        "m": null,
        "kind": "post",
        "text": "徐温成为弘农摄政，任严可求为扬州司马管军事，与骆知祥并称“严、骆”",
        "seat": "广陵"
      },
      {
        "y": 909,
        "m": null,
        "kind": "event",
        "text": "危全讽起事，严可求推荐周本，周本败俘危全讽",
        "seat": "广陵"
      },
      {
        "y": 911,
        "m": null,
        "kind": "event",
        "text": "卢光稠卒，严可求建议在新淦县置制置使并派兵戍守，图谋虔州",
        "seat": "广陵"
      },
      {
        "y": 916,
        "m": 2,
        "kind": "event",
        "text": "马谦、李球劫持杨隆演将攻徐知训，严可求劝徐知训勿逃，睡觉以示无所畏惧，安抚众人",
        "seat": "广陵"
      },
      {
        "y": 918,
        "m": null,
        "kind": "event",
        "text": "吴国攻虔州，严可求招募赣石水工打开赣江水路；朱瑾杀徐知训，严可求诈称袁州吴军大破楚军，擒杀米志诚；劝徐温勿大行诛戮",
        "seat": "广陵"
      },
      {
        "y": 918,
        "m": null,
        "kind": "event",
        "text": "严可求屡劝徐温以徐知询代徐知诰为少摄政；徐知诰与骆知祥合谋将严可求逐出广陵为楚州刺史；严可求说服徐温留广陵参总庶政，草具礼仪；徐知诰把女儿嫁给严可求之子严续",
        "seat": "广陵"
      },
      {
        "y": 919,
        "m": null,
        "kind": "post",
        "text": "杨隆演称吴国王，严可求被授门下侍郎",
        "seat": "广陵"
      },
      {
        "y": 920,
        "m": null,
        "kind": "event",
        "text": "杨隆演过世，严可求说国王诸子皆不才，引刘备托孤事；徐温与王令谋定计迎杨溥监国",
        "seat": "广陵"
      },
      {
        "y": 921,
        "m": 11,
        "kind": "post",
        "text": "杨溥拜严可求为右仆射",
        "seat": "广陵"
      },
      {
        "y": 923,
        "m": null,
        "kind": "event",
        "text": "李存勖建后唐，要求吴合攻后梁；严可求反对派舰队北上；后梁灭后，严可求预言后唐将有内变，建议卑辞厚礼保境安民；教卢𬞟应对庄宗问话",
        "seat": "广陵"
      },
      {
        "y": 926,
        "m": 3,
        "kind": "post",
        "text": "严可求再被任为兼门下侍郎，加同中书门下平章事，为宰相",
        "seat": "广陵"
      },
      {
        "y": 926,
        "m": 4,
        "kind": "event",
        "text": "庄宗死于兵变，李嗣源继位；消息传到吴国，徐温因严可求预言正确更加器重他",
        "seat": "广陵"
      },
      {
        "y": 927,
        "m": null,
        "kind": "event",
        "text": "徐温准备亲往广陵建议杨溥称帝号，病，派徐知询代上表；徐温死，杨溥依表文称帝",
        "seat": "广陵"
      },
      {
        "y": 928,
        "m": null,
        "kind": "event",
        "text": "杨溥派王彦章、苗璘伐楚，陈璋对严可求说朝廷为何不用陈璋和周本；王彦章果然兵败",
        "seat": "广陵"
      },
      {
        "y": 930,
        "m": 11,
        "kind": "death",
        "text": "严可求在左仆射、宰相任上过世",
        "seat": "广陵"
      }
