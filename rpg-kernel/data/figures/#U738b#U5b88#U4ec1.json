    "situation": {
      "1519": [
        {
          "from": 1,
          "text": "任巡撫南贛，駐贛州，日常處理地方軍政、剿撫民變。",
          "tension": null,
          "src": "《明史·王守仁傳》",
          "conf": "low",
          "basis": "recorded"
        },
        {
          "from": 6,
          "text": "奉命勘福建叛軍，行至豐城，聞寧王朱宸濠反，知縣顧佖以告。急趨吉安，與伍文定征調兵食，治器械舟楫，傳檄暴宸濠罪，俾守令各率吏士勤王。",
          "tension": "T-SIT-001",
          "src": "《明史·王守仁傳》",
          "conf": "medium",
          "basis": "recorded"
        },
        {
          "from": 7,
          "text": "已調集八萬大軍，對外號稱三十萬。寧王率六萬士卒攻下九江、南康，渡長江攻安慶。有人指出應該急救安慶，王守仁認為若越過南昌跨江救援安慶，會腹背受敵，決定先攻南昌。",
          "tension": "T-SIT-002",
          "src": "《明史·王守仁傳》",
          "conf": "medium",
          "basis": "recorded"
        }
      ],
      "1520": [
        {
          "from": 1,
          "text": "寧王之亂已平，但明武宗以「威武大將軍朱壽」化名出征，江彬有意釋放寧王，讓武宗與寧王打一仗並親自俘獲。王守仁對宦官張永動之以情、曉之以理，說明這樣做會死更多人。最後協調結果是：讓明武宗到了南京，再放出寧王讓皇帝俘虜。",
          "tension": "T-SIT-003",
          "src": "《明史·王守仁傳》",
          "conf": "medium",
          "basis": "recorded"
        }
      ],
      "1521": [
        {
          "from": 1,
          "text": "明武宗駕崩，無子。堂弟朱厚熜繼承帝位，因王陽明平定寧王之亂有功，明世宗特詔封為新建伯、授南京兵部尚書、照舊參贊機務。",
          "tension": null,
          "src": "《明史·王守仁傳》",
          "conf": "medium",
          "basis": "recorded"
        }
      ],
      "1522": [
        {
          "from": 1,
          "text": "在南京兵部尚書任上，參贊機務。",
          "tension": null,
          "src": "《明史·王守仁傳》",
          "conf": "medium",
          "basis": "recorded"
        }
      ],
      "1523": [
        {
