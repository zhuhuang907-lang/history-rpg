      },
      {
        "y": 1068,
        "m": 1,
        "kind": "event",
        "text": "正月一日，有诏改元熙宁。",
        "seat": "东京",
        "identity": "emperor"
      },
      {
        "y": 1068,
        "m": null,
        "kind": "event",
        "text": "宋神宗赵顼命翰林学士王安石越次入对。",
        "seat": "东京",
        "identity": "emperor"
      },
      {
        "y": 1070,
        "m": null,
        "kind": "event",
        "text": "王安石拜相，主持变法，均输、青苗、农田水利、免役、市易、保甲、方田均税、保马等新法相继出笼。",
        "seat": "东京",
        "identity": "emperor"
      },
      {
        "y": 1072,
        "m": null,
        "kind": "event",
        "text": "王韶收复今临洮与临夏，升镇洮军为熙州，设熙河路。",
        "seat": "熙州",
        "identity": "emperor"
      },
      {
        "y": 1073,
        "m": null,
        "kind": "event",
        "text": "王韶率兵攻占武胜城，乘胜追击，进攻河州，直捣定羌城。",
        "seat": "河州",
        "identity": "emperor"
      },
      {
        "y": 1075,
        "m": null,
        "kind": "event",
        "text": "发生赵世居之狱，宋神宗处刑残酷。",
        "seat": "东京",
        "identity": "emperor"
      },
      {
        "y": 1079,
        "m": 12,
        "kind": "event",
        "text": "乌台诗案于十二月结束，苏轼贬谪为黄州团练副使。",
        "seat": "东京",
        "identity": "emperor"
      },
      {
        "y": 1081,
        "m": 11,
        "kind": "event",
        "text": "宋军于庆州击溃夏军，占领西夏两千多里土地。",
        "seat": "庆州",
        "identity": "emperor"
      },
      {
        "y": 1082,
        "m": 9,
        "kind": "event",
        "text": "徐禧、种谔带兵攻夏，筑永乐城，永乐城之战大败，宋军损失二十万军士。",
        "seat": "永乐城",
        "identity": "emperor"
      },
