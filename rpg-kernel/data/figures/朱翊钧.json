      },
      {
        "y": 1583,
        "m": null,
        "kind": "event",
        "text": "斥逐冯保，下诏追夺张居正的封号和谥号，并查抄张家，平反刘台冤案，起用因反对张居正而遭惩处的官员。",
        "seat": "北京"
      },
      {
        "y": 1587,
        "m": null,
        "kind": "event",
        "text": "亲政后励精图治，虚心纳谏，屡蠲赋税，生活节俭。",
        "seat": "北京"
      },
      {
        "y": 1588,
        "m": null,
        "kind": "event",
        "text": "明神宗开始怠慢朝政。",
        "seat": "北京"
      },
      {
        "y": 1589,
        "m": null,
        "kind": "event",
        "text": "神宗不再接见朝臣，内阁出现了“人滞于官”和“曹署多空”的现象。",
        "seat": "北京"
      },
      {
        "y": 1601,
        "m": null,
        "kind": "event",
        "text": "利玛窦觐见神宗，向神宗进呈《万国图志》、自鸣钟、大西洋琴等西方方物，获得了神宗的信任。",
        "seat": "北京"
      },
      {
        "y": 1620,
        "m": 7,
        "kind": "death",
        "text": "神宗皇帝崩于紫禁城弘德殿内，享年五十八岁。",
        "seat": "北京"
      }
    ],
    "resources": {
      "note": "万历初年太仓的积粟达1300万石，可支用十年，仅仅是太仆寺的银两储蓄便多达四百余万，而太仓库更是有超过千万两的积蓄；三大征实际军费则由内帑和太仓库银足额拨发。",
      "src": "维基百科·朱翊钧",
      "conf": "low"
    },
    "tensions": {},
    "situation": {
      "1587": [
        {
          "from": 1,
          "text": "张居正死后，二十岁的神宗始亲政，励精图治，虚心纳谏，屡蠲赋税，生活节俭。",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        },
        {
          "from": 1,
          "text": "万历十一年间，蠲免并灾伤织造议留就已达银一百七十六万一千两。",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        },
        {
          "from": 1,
          "text": "（此时处境史料未详，待据史补录）",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        },
        {
          "from": 1,
          "text": "（此时处境史料未详，待据史补录）",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        },
        {
          "from": 1,
          "text": "敕六部都察院等曰：“天旱虽由朕不德，亦天下有司贪婪，剥害小民，以致上干天和，今后宜慎选有司。”蠲天下被灾田租一年。",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        }
      ],
      "1588": [
        {
          "from": 1,
          "text": "（此时处境史料未详，待据史补录）",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        },
        {
          "from": 12,
          "text": "大理寺左评事雒于仁写《酒色财气四箴疏》：“皇上之恙，病在酒色财气也。夫纵酒则溃胃，好色则耗精，贪财则乱神，尚气则损肝”。",
          "tension": null,
          "src": "维基百科·朱翊钧",
          "conf": "medium",
          "basis": "recorded"
        }
      ],
      "1589": [
        {
          "from": 1,
          "text": "神宗不再接见朝臣，内阁出现了“人滞于官”和“曹署多空”的现象。",
          "tension": null,
